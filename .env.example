# ==========================================
# 🪪 ID CARD PORTAL - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# [BACKEND] Node.js API Settings
# ------------------------------------------
# The port the backend server will run on
PORT=5000

# The connection string for your PostgreSQL database (e.g., NeonDB)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"

# The URL of your frontend application (used for CORS and email links)
FRONTEND_URL="http://localhost:3000"

# Secret key for signing JWT auth cookies (generate a random 64-char string)
JWT_SECRET="your_super_secret_jwt_string_here"

# (Optional) Admin email for system notifications/from-address
SYSTEM_EMAIL="admin@yourdomain.com"

# Default password for the first SuperAdmin seeded into the database
SUPERADMIN_DEFAULT_PASSWORD="TempPassword123!"

# ------------------------------------------
# [BACKEND] Third-Party API Keys
# ------------------------------------------
# Cloudinary (Used for storing member photos and signatures)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Brevo / Sendinblue (Used for sending Forgot Password / Invite emails over HTTP)
# Ensure this is the API v3 Key
BREVO_API_KEY="xkeysib-your-brevo-api-key"

# ------------------------------------------
# [FRONTEND] Next.js Settings (Located in frontend/.env.local)
# ------------------------------------------
# The URL pointing to your backend API
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
