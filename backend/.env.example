# ==========================================
# ⚙️ BACKEND ENVIRONMENT VARIABLES
# ==========================================

# --- Core Server ---
PORT=5000
# Connection string (e.g., NeonDB or local Postgres)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"
# Authorized origin for CORS
FRONTEND_URL="http://localhost:3000"

# --- Authentication ---
# 64-character random hex string for JWT signing
JWT_SECRET="generate_a_secure_random_string_here"
# Default password applied to the SuperAdmin during Prisma DB seeding
SUPERADMIN_DEFAULT_PASSWORD="TempPassword123!"

# --- Email Service (Brevo) ---
# Must be the v3 API Key (starts with xkeysib-)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
# The verified sender email address in your Brevo dashboard
SYSTEM_EMAIL="admin@friendsofeducation.in"

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
